<Window x:Class="CTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор дипломов"
        Width="1100"
        Height="750">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ============================================ -->
        <!-- ЗАГОЛОВОК -->
        <!-- ============================================ -->

        <TextBlock Text="Генератор дипломов"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>


        <!-- ============================================ -->
        <!-- ВЫБОР ФАЙЛОВ -->
        <!-- ============================================ -->

        <StackPanel Grid.Row="1">

            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="ExcelPathTextBox"
                         Height="35"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Excel..."
                        Margin="10,0,0,0"
                        Click="SelectExcel_Click"/>

            </Grid>


            <Grid Margin="0,0,0,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TemplatePathTextBox"
                         Height="35"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Шаблон..."
                        Margin="10,0,0,0"
                        Click="SelectTemplate_Click"/>

            </Grid>


            <Button x:Name="GenerateButton"
                    Content="Показать предпросмотр"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="Generate_Click"/>

            <Button x:Name="GenerateAllButton"
                    Content="Сгенерировать дипломы"
                    Height="40"
                    Click="GenerateAll_Click"/>

        </StackPanel>


        <!-- ============================================ -->
        <!-- РЕДАКТОР -->
        <!-- ============================================ -->

        <Grid Grid.Row="2"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- ======================================== -->
            <!-- ПРЕДПРОСМОТР -->
            <!-- ======================================== -->

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    Margin="0,0,20,0">

                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">

                    <Grid x:Name="PreviewContainer"
                          Width="700"
                          Height="495">

                        <!-- Сам диплом -->
                        <Image x:Name="PreviewImage"
                               Stretch="Fill"
                               MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                               MouseMove="PreviewImage_MouseMove"
                               MouseLeftButtonUp="PreviewImage_MouseLeftButtonUp"/>

                        <!-- Рамка -->
                        <Canvas x:Name="SelectionCanvas"
                                IsHitTestVisible="False">

                            <Border x:Name="SelectionBorder"
                                    BorderBrush="DodgerBlue"
                                    BorderThickness="2"
                                    Visibility="Collapsed"/>

                        </Canvas>

                    </Grid>

                </ScrollViewer>

            </Border>


            <!-- ======================================== -->
            <!-- НАСТРОЙКИ -->
            <!-- ======================================== -->

            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <TextBlock Text="Настройки элемента"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,20"/>


                    <TextBlock Text="Элемент"/>

                    <ComboBox x:Name="ElementComboBox"
                              Height="35"
                              Margin="0,5,0,15"
                              SelectionChanged="ElementComboBox_SelectionChanged"/>


                    <TextBlock Text="X"/>

                    <TextBox x:Name="XTextBox"
                             Height="30"
                             Margin="0,5,0,10"/>


                    <TextBlock Text="Y"/>

                    <TextBox x:Name="YTextBox"
                             Height="30"
                             Margin="0,5,0,10"/>


                    <TextBlock Text="Размер шрифта"/>

                    <TextBox x:Name="FontSizeTextBox"
                             Height="30"
                             Margin="0,5,0,10"/>


                    <TextBlock Text="Масштаб по ширине"/>

                    <TextBox x:Name="WidthScaleTextBox"
                             Height="30"
                             Margin="0,5,0,10"/>


                    <TextBlock Text="Масштаб по высоте"/>

                    <TextBox x:Name="HeightScaleTextBox"
                             Height="30"
                             Margin="0,5,0,20"/>


                    <Button Content="Применить"
                            Height="40"
                            Click="ApplySettings_Click"/>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>